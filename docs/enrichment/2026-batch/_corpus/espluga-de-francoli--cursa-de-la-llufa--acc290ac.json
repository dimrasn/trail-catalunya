t/core/modules/e1d9dfe6e5/cookiebanner/js/complianz.min.js","https://caesplugui.cat/core/modules/9097659473/assets/front-end/js/view/table-of-content.min.js","https://schema.org/","https://caesplugui.cat/storage/2023/11/track_cursa.png","https://caesplugui.cat/?s={search_term_string}","https://caesplugui.cat/storage/2023/05/cropped-cropped-logo-cae-web.png","https://caesplugui.cat/core/modules/9097659473/assets/admin/images/templately/logo-icon.svg","https://schema.org/WebPage","https://schema.org/WPHeader","https://schema.org/Organization","https://caesplugui.cat/storage/2023/05/logo-cae-web-light-300x300.png","https://caesplugui.cat/storage/2023/05/logo-cae-web-light-150x150.png","https://schema.org/SiteNavigationElement","http://www.w3.org/2000/svg","http://www.w3.org/1999/xlink","https://schema.org/CreativeWork","https://caesplugui.cat/storage/2025/11/almohada_corazon-1024x1011.jpg","https://caesplugui.cat/storage/2025/11/almohada_corazon-768x758.jpg","https://caesplugui.cat/storage/2025/11/almohada_corazon.jpg","https://schema.org/WPFooter","https://caesplugui.cat/core/modules/f42042aa40/","https://caesplugui.cat/core/modules/f42042aa40/assets/images","https://caesplugui.cat/gestio/","https://caesplugui.cat/wp-json/","https://caesplugui.cat/gestio/admin-ajax.php","https://caesplugui.cat/core/modules/f42042aa40/assets/images/placeholder.png","https://essential-blocks.com/upgrade","https://caesplugui.cat/gestio/post.php?post={{id}}&action=edit","http://wiki.lexisnexis.com/academic/images/f/fb/Itunes_podcast_icon_300.jpg","https://caesplugui.cat/core/modules/717caac2bc/assets/min-js/uael-particles.min.js","https://caesplugui.cat/core/modules/717caac2bc/assets/lib/particles/particles.min.js","https://caesplugui.cat/core/modules/717caac2bc/assets/img/snowflake.svg","https://caesplugui.cat/core/modules/717caac2bc/assets/img/gift.png","https://caesplugui.cat/core/modules/717caac2bc/assets/img/tree.png","https://caesplugui.cat/core/modules/717caac2bc/assets/img/skull.png","https://caesplugui.cat/core/modules/717caac2bc/assets/img/ghost.png","https://caesplugui.cat/core/modules/717caac2bc/assets/img/moon.png","https://caesplugui.cat/core/modules/717caac2bc/assets/img/bat.png","https://caesplugui.cat/core/modules/717caac2bc/assets/img/pumpkin.png","https://caesplugui.cat/wp-json/complianz/v1/","https://caesplugui.cat/storage/complianz/css/banner-%7Bbanner_id%7D-%7Btype%7D.css?v=16","https://s.w.org/images/core/emoji/17.0.2/72x72/","https://s.w.org/images/core/emoji/17.0.2/svg/","https://caesplugui.cat/lib/js/wp-emoji-release.min.js","https://caesplugui.cat/lib/js/wp-emoji-loader.min.js"]},{"url":"https://caesplugui.cat/cursa-atletica/","hash":"74b0805e052994e6d7f1477dcf882a3813bb4e43102b3fb416ac3d6edd295c0f","chars":7354,"text":"Vés al contingut Main Menu INSCRIPCIONS INSCRIPCIONS CURSA 5K INSCRIPCIONS CURSA 10K REGLAMENT Veure reglament RESULTATS CURSA 2026 Veure taules DESCRIPCIÓ Ja estem a punt per arribar a l estiu, però la junta del club atlètic ja fa uns mesos que estem treballant en l organització de la 47a CURSA DE L ESPLUGA DE FRANCOLÍ que es durà a terme el dia 1 d agost a les 7 de la tarda i com sempre, coincideix amb el dissabte de la Festa Major. Aquest any mantenim les dues curses : de 10km i 5km. El preu de les inscripcions serà variable i per trams: Preu soci: 5k: 5€ 10k: 10€ Mateix dia 20€. Preu no soci: 10k: 1r tram, obertura inscripcions 31 maig, 12€ 2n tram, 1 juny fins al 24 de juny 15€ 3r tram 25 de juny fins a 25 de juliol o acabar inscripcions, 17€ Inscripcions: mateix dia 20€ Preu no soci 5k: 1r tram, obertura inscripcions 31 maig, 10€ 2n tram, 1 juny fins a 25 de juliol o acabar inscripcions, 12€ Inscripcions: Mateix dia 20€ Amb el pagament de la inscripció l’atleta tindrà la tradicional bossa amb una samarreta tècnica i altres productes típics el nostre poble. Les inscripcions fetes fins al 14 de juny tindran la talla de la samarreta garantida (hi haurà disponible tallatge d home i de dona): HISTÒRIA La cursa de l Espluga s inicià l any 1978, amb els primers ajuntaments democràtics. Un grup de joves del poble, que editaven El Clam, una revista en Català i ”revolucionària” , la van incloure dins la Festa Major, sota el lema «Per una Festa Major Popular» , és per això que la cursa neix com «Cursa Popular de l Espluga». A les primeres edicions, el recorregut era pels carrers del poble i la distància rondava els 5 quilòmetres. Sobre els i les participants, no superaven els 40 o 50, tothom eren de l Espluga i pobles del voltant. Després dels primers anys de consolidació es dóna un pas important amb la incorporació d en Josep Maria Pons al capdavant de l organització: s amplia i estabilitza el recorregut: la sortida i l arribada es fan a la Plaça de l Església i la distància passa a ser de 15 quilòmetres justos i ben mesurats, s incorpora la cursa al campionat organitzat per Marató Catalunya i tot això fa augmentar la participació que es situa entre 150 i 200 amb participants de tot Catalunya. Més endavant cap el any 1986 s incorpora nova gent a l organització, i la cursa va augmentant en participants, la sortida i l arribada es traslladen fins el davant el Casal, i el recorregut es consolida en el 15 quilòmetres, ara ja mesurats i certificats per l AIMS (Associació Internacional de Maratons), s inclou en el recorregut l entrada a Poblet per tal de fer la cursa més distreta i atractiva, i es segueix formant part de la Copa Catalana de Fons . El 1994 s incorporen a la cursa els avenços informàtics, les classificacions ja es feien mitjançant programes informàtics. Al 1997 s incorpora el sistema «championchip», un xip electrònic posat a la sabatilla de cada participant fa que, quan passi pel damunt de una catifa de «tartan», posada tant a la sortida, com a la arribada, es posi en marxa o s aturi el cronòmetre individualment. La col·locació de la catifa a mig recorregut permet el fer controls de pas per evitar els malentesos. Tot això permet enllestir les classificacions ràpidament i que els i les corredores coneguin la seva marca pocs moments després d haver acabat. La Cursa de l Espluga és pionera a Catalunya en aquest sistema de mesurar el temps i fou la segona cursa de casa nostra que ho va implantar, darrera de Marató Catalunya. Per tothom que participa a la cursa, que han passat dels 50 a més de 500 persones inscrites al llarg d aquests anys, és tot un repte acabar-la i millorar els registres dels anys anteriors. Tot i la duresa de la prova, a finals de juliol o principis d agost, amb molta calor i un recorregut de pujada fins al quilòmetre 8 5, els corredors i les corredores son fidels gràcies a una molt bona organització que fa possible que cada any hi hagi un nombre d atletes que repeteixen i que conviden a les seves amistats a participar-hi. L’any 2015 s’afegeix una nova modalitat de cursa, una més petita de 5 km, on hi participa una Espluguina una diversitat funcional, va amb una cadira adaptada per córrer. Molts espluguins i espluguines i gent coneguda l’acompanyen en el transport durant el recorregut. El projecte de la Noe Gaya s’anomena “sempre endavant” i es posa també el nom a les samarretes així com el logotip creat per ella mateixa. Actualment la cursa és pel Club Atlètic Espluguí que, amb el suport de l Ajuntament de l Espluga de Francolí, és l’encarregat de portar el lideratge per tal que la cursa sigui un èxit. Així doncs, el dia de l’esdeveniment hi participen desinteressadament, unes 150 persones del municipi entre els avituallaments, els controls, la preparació de l arribada i la sortida, la confecció de les bosses amb els records, l entrega de premis, els vestidors i el guardar-roba, la realització de les classificacions, l atenció diversa als i a les atletes, el marcatge del circuit i l entrega de premis, i tantes altres petites qüestions que surten en un esdeveniment tant multitudinari. Així doncs, la i després de moltes edicions , la “Cursa de l’Espluga” és una de les més prestigioses de Catalunya. COL·LABORA